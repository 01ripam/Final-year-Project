# ─────────────────────────────────────────────────────────────────────────────
# Enterprise NIDS — Environment Configuration Template
# Copy this file to `.env` and adjust the values as needed.
# ─────────────────────────────────────────────────────────────────────────────

# ── TimescaleDB (PostgreSQL) Configuration ──────────────────────────────────
POSTGRES_USER=nids
POSTGRES_PASSWORD=nids_secret
POSTGRES_DB=nids_db
POSTGRES_PORT=5432

# When running python services locally (outside of Docker), use "localhost"
# When running python services inside Docker, docker-compose will override this to "timescaledb"
POSTGRES_HOST=localhost

# ── Grafana Configuration ───────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Redis Configuration ─────────────────────────────────────────────────────
# When running python services locally (outside of Docker), use "redis://localhost:6379/0"
# When running python services inside Docker, docker-compose will override this to "redis://redis:6379/0"
REDIS_URL=redis://localhost:6379/0
FLOW_QUEUE_KEY=flow:queue

# ── Celery Task Queue Configuration ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
