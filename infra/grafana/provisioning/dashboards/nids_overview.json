{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "postgres", "name": "PostgreSQL", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Enterprise NIDS — Real-time SOC Overview Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🔴 Live Threat Feed",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short",
          "displayName": "Alerts (last 5 min)"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT COUNT(*) as value FROM predictions WHERE predicted_class != 'Normal' AND inference_timestamp >= NOW() - INTERVAL '5 minutes'",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Active Alerts (5 min)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 500 }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT COUNT(*) as value FROM flows WHERE capture_timestamp >= NOW() - INTERVAL '1 hour'",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Flows Processed (1 hr)",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }, "unit": "ms", "displayName": "Avg Inference Latency" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT ROUND(AVG(inference_latency_ms)::numeric, 2) as value FROM predictions WHERE inference_timestamp >= NOW() - INTERVAL '5 minutes'",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Avg Inference Latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.95 }] }, "unit": "percentunit", "displayName": "Avg Confidence" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT ROUND(AVG(confidence)::numeric, 4) as value FROM predictions WHERE predicted_class != 'Normal' AND inference_timestamp >= NOW() - INTERVAL '5 minutes'",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Avg Alert Confidence",
      "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 5 },
      "id": 10,
      "options": { "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  time_bucket('1 minute', inference_timestamp) AS time,\n  predicted_class AS metric,\n  COUNT(*) AS value\nFROM predictions\nWHERE\n  predicted_class != 'Normal'\n  AND $__timeFilter(inference_timestamp)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Alerts per Minute — by Attack Class",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 5 },
      "id": 11,
      "options": { "displayLabels": ["percent", "name"], "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "values": ["value", "percent"] }, "pieType": "donut", "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  predicted_class AS metric,\n  COUNT(*) AS value\nFROM predictions\nWHERE\n  predicted_class != 'Normal'\n  AND $__timeFilter(inference_timestamp)\nGROUP BY predicted_class\nORDER BY value DESC",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Attack Class Distribution",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 101,
      "title": "📊 Model Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 1, "fillOpacity": 10 }, "unit": "ms" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 20,
      "options": { "legend": { "calcs": ["mean", "max", "p95"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  time_bucket('1 minute', inference_timestamp) AS time,\n  model_name AS metric,\n  ROUND(AVG(inference_latency_ms)::numeric, 2) AS value\nFROM predictions\nWHERE $__timeFilter(inference_timestamp)\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Inference Latency by Model (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  time_bucket('1 minute', capture_timestamp) AS time,\n  'Flows/min' AS metric,\n  COUNT(*) AS value\nFROM flows\nWHERE $__timeFilter(capture_timestamp)\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "title": "Flow Ingestion Rate (flows/min)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 102,
      "title": "🔍 Threat Intelligence",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "attack_count" }, "properties": [{ "id": "custom.displayMode", "value": "lcd-gauge" }, { "id": "color", "mode": "thresholds" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "attack_count" }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  f.src_ip::text AS src_ip,\n  p.predicted_class AS attack_class,\n  COUNT(*) AS attack_count,\n  ROUND(MAX(p.confidence)::numeric, 3) AS max_confidence\nFROM predictions p\nJOIN flows f ON f.flow_id = p.flow_id\nWHERE\n  p.predicted_class != 'Normal'\n  AND $__timeFilter(p.inference_timestamp)\nGROUP BY f.src_ip, p.predicted_class\nORDER BY attack_count DESC\nLIMIT 20",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Top Attacking Source IPs",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "hit_count" }, "properties": [{ "id": "custom.displayMode", "value": "lcd-gauge" }, { "id": "color", "mode": "thresholds" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "hit_count" }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  f.dst_ip::text AS dst_ip,\n  f.dst_port AS dst_port,\n  COUNT(*) AS hit_count,\n  STRING_AGG(DISTINCT p.predicted_class, ', ') AS attack_types\nFROM predictions p\nJOIN flows f ON f.flow_id = p.flow_id\nWHERE\n  p.predicted_class != 'Normal'\n  AND $__timeFilter(p.inference_timestamp)\nGROUP BY f.dst_ip, f.dst_port\nORDER BY hit_count DESC\nLIMIT 20",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Top Targeted Destinations",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 103,
      "title": "🧠 XAI — SHAP Feature Importance",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 35 },
      "id": 40,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "occurrence_count" }] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
          "rawSql": "SELECT\n  UNNEST(top_features) AS feature_name,\n  COUNT(*) AS occurrence_count,\n  explainer_type\nFROM shap_explanations\nWHERE $__timeFilter(explanation_timestamp)\nGROUP BY feature_name, explainer_type\nORDER BY occurrence_count DESC\nLIMIT 30",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Most Impactful SHAP Features (across all alerts)",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["nids", "security", "ml"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "postgres", "uid": "timescaledb-uid" },
        "definition": "SELECT DISTINCT model_name FROM predictions ORDER BY model_name",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "model",
        "options": [],
        "query": "SELECT DISTINCT model_name FROM predictions ORDER BY model_name",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "label": "Model",
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Enterprise NIDS — SOC Overview",
  "uid": "nids-soc-overview",
  "version": 1
}
